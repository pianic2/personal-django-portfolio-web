# Development only. Never commit a real production secret.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DATABASE_URL=sqlite:///db.sqlite3
DJANGO_BASE_URL=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pianic2.github.io
DJANGO_CONTACT_RECIPIENT_EMAIL=you@example.com
DJANGO_DEFAULT_FROM_EMAIL=portfolio@example.com
# Production provider settings remain server-side and are never sent to React.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
# Production also requires a strong DJANGO_SECRET_KEY and explicit hosts. HTTPS
# settings are enabled automatically when DJANGO_DEBUG=false.
