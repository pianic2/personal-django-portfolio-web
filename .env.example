# Development only. Never commit a real production secret.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DATABASE_URL=sqlite:///db.sqlite3
DJANGO_BASE_URL=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pianic2.github.io
# Production also requires a strong DJANGO_SECRET_KEY and explicit hosts. HTTPS
# settings are enabled automatically when DJANGO_DEBUG=false.
