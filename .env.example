# Development only. Never commit a real production secret.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
DJANGO_BASE_URL=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pianic2.github.io
DJANGO_CONTACT_RECIPIENT_EMAIL=you@example.com
DJANGO_DEFAULT_FROM_EMAIL=portfolio@example.com
# Wagtail API credential used only by the MCP service.
WAGTAIL_AGENT_API_TOKEN=
# Dedicated inbound MCP credential. Use a different value from the Wagtail token.
PDPW_MCP_INBOUND_TOKEN=
# Empty denies all browser Origin headers; clients without Origin remain supported.
PDPW_MCP_ALLOWED_ORIGINS=
# OAuth 2.1 proxy configuration. Set all four to enable Google OIDC.
PDPW_OAUTH_UPSTREAM_CLIENT_ID=
PDPW_OAUTH_UPSTREAM_CLIENT_SECRET=
PDPW_OAUTH_JWT_SIGNING_KEY=
# Comma-separated verified Google email allowlist; never commit values.
PDPW_OAUTH_ALLOWED_IDENTITIES=
PDPW_OAUTH_BASE_URL=https://pdpw-production.onrender.com
PDPW_OAUTH_ISSUER_URL=https://pdpw-production.onrender.com
# Production provider settings remain server-side and are never sent to React.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10
# Production also requires a strong DJANGO_SECRET_KEY and explicit hosts. HTTPS
# settings are enabled automatically when DJANGO_DEBUG=false.
# Production media uses an S3-compatible bucket (for example, Cloudflare R2).
# Leave these unset for credential-free local media.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=false
